# Copy to .env and replace every placeholder. Never commit .env.
# lib/env.ts refuses to start while any value still contains "REPLACE" or "YOUR_".

# Supabase → Connect → ORMs/Prisma. Transaction pooler (port 6543), used at runtime
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
# Session pooler (port 5432), used by Prisma migrate (the direct host is IPv6-only on free tier)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"
# openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
# Base URL of the app. Use your Vercel domain in production
NEXTAUTH_URL="http://localhost:3000"
# Which LLM powers classification, Ask LOOP and reports: "anthropic" (Claude) or "gemini" (free tier)
AI_PROVIDER="gemini"
# aistudio.google.com → Get API key. SERVER ONLY. Required when AI_PROVIDER=gemini
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash-lite"
# Max parallel LLM calls per batch (keep 2 on Gemini free tier, up to 8 on paid Claude)
AI_CONCURRENCY="2"
# console.anthropic.com → API keys. SERVER ONLY. Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
# Claude model used for classification, Ask LOOP and reports
ANTHROPIC_MODEL="claude-sonnet-4-6"
# dash.voyageai.com → API keys. SERVER ONLY
VOYAGE_API_KEY="pa-REPLACE_ME"
# Voyage embedding model (voyage-3.5-lite supports 1024-dim output)
EMBEDDING_MODEL="voyage-3.5-lite"
# Must match vector(1024) in prisma/schema.prisma
EMBEDDING_DIMENSIONS="1024"
# Demo-only password shared by the seeded admin/analyst/viewer accounts
SEED_DEMO_PASSWORD="REPLACE_WITH_DEMO_ONLY_PASSWORD"
