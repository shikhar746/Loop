# Copy to .env and fill in. Never commit .env.

# Neon Postgres connection string (pooled). Prisma needs `?sslmode=require`.
# Get it from: Neon console -> your project -> Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth: secret used to sign session JWTs and the canonical app URL.
# Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API key — SERVER ONLY. Used by lib/ai.ts for classification,
# Ask LOOP (RAG) and Voice-of-Customer reports. Never expose to the browser.
ANTHROPIC_API_KEY=""
